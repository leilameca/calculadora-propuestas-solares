generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  COMPANY_ADMIN
  SALES
  ENGINEER
  VIEWER
}

enum EquipmentType {
  PANEL
  INVERTER
  BATTERY
  STRUCTURE
  PROTECTION
  OTHER
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Company {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  rnc                 String?
  address             String?
  phone               String?
  email               String?
  website             String?
  slogan              String?
  logoUrl              String?
  primaryColor        String               @default("#0F4C5C")
  secondaryColor      String               @default("#2F7D32")
  accentColor         String               @default("#F2A900")
  itbisEnabled        Boolean              @default(true)
  itbisRate           Decimal?             @db.Decimal(5, 4)
  proposalValidityDays Int                 @default(15)
  coverImages         Json?
  active              Boolean              @default(true)
  users               User[]
  customers           Customer[]
  equipment           EquipmentInventory[]
  proposals           Proposal[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model User {
  id           String    @id @default(cuid())
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(SALES)
  active       Boolean   @default(true)
  proposals    Proposal[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
}

model Customer {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  nic       String?
  rnc       String?
  email     String?
  phone     String?
  address   String?
  city      String?
  utility   String?
  tariff    String?
  proposals Proposal[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([companyId, name])
  @@unique([companyId, nic])
}

model EquipmentInventory {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type           EquipmentType
  brand          String
  model          String
  description    String?
  powerWatts     Int?
  capacityKwh    Decimal?      @db.Decimal(10, 2)
  unitCostUsd    Decimal       @db.Decimal(12, 2)
  quantity       Int           @default(0)
  warrantyYears  Int?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([companyId, type, active])
  @@unique([companyId, brand, model])
}

model Proposal {
  id                  String         @id @default(cuid())
  number              String
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdById         String
  createdBy           User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  status              ProposalStatus @default(DRAFT)
  projectName         String
  systemType          String
  city                String
  utility             String
  tariff              String
  monthlyConsumption  Json
  calculationInput    Json
  calculationResult   Json
  quoteItems          Json
  selectedInverterId  String?
  manualInverter      String?
  exchangeRate        Decimal        @db.Decimal(10, 4)
  subtotalUsd         Decimal        @db.Decimal(12, 2)
  taxUsd              Decimal        @db.Decimal(12, 2)
  totalUsd            Decimal        @db.Decimal(12, 2)
  validUntil          DateTime
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([companyId, number])
  @@index([companyId, status, createdAt])
  @@index([customerId])
}
