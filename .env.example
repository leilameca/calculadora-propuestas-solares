# Base de datos PostgreSQL (Railway, Render, Neon o VPS)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/database?schema=public"

# Autenticación JWT (genera una cadena larga aleatoria)
AUTH_SECRET="cambia-esta-clave-por-una-cadena-aleatoria-larga"

# Cuenta SuperAdmin inicial (usada por npm run db:seed)
SUPERADMIN_EMAIL="admin@solar.local"
SUPERADMIN_PASSWORD="ChangeMe123!"

# OCR: Tesseract.js local para imágenes (sin configuración adicional)
# OCR: AWS Textract para PDFs multipágina (opcional)
AWS_REGION="us-east-1"
AWS_TEXTRACT_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# En desarrollo el dashboard abre sin sesión. En producción siempre exige sesión.
ALLOW_DEV_DASHBOARD="true"