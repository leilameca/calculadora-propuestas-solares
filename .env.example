# Base de datos PostgreSQL (Railway, Render, Neon o VPS)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/database?schema=public"

# Autenticación JWT (genera una cadena larga aleatoria)
AUTH_SECRET="cambia-esta-clave-por-una-cadena-aleatoria-larga"
# Duracion de la sesion persistente. Valor permitido: 1 a 90 dias.
SESSION_MAX_AGE_DAYS="30"

# Cuenta SuperAdmin inicial (usada por npm run db:seed)
SUPERADMIN_EMAIL="tu-correo-administrador@empresa.com"
SUPERADMIN_PASSWORD="usa-una-clave-unica-de-al-menos-12-caracteres"

# OCR: Tesseract.js local para imágenes (sin configuración adicional)
# OCR: AWS Textract para PDFs multipágina (opcional)
AWS_REGION="us-east-1"
AWS_TEXTRACT_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Dashboard cerrado por defecto. Activar true solo en una demo local.
ALLOW_DEV_DASHBOARD="false"

# Archivos privados: local solo desarrollo; configurar s3 en producci?n.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR=".storage"
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_FORCE_PATH_STYLE="false"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
